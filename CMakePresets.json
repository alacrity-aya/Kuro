{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets",
        "VCPKG_TARGET_TRIPLET": "x64-linux-kuro"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug Config",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",

        "CMAKE_CXX_FLAGS_DEBUG": "-g -O0 -Wall -Wextra -fdiagnostics-color=always -fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_C_FLAGS_DEBUG":   "-g -O0 -Wall -Wextra -fdiagnostics-color=always -fsanitize=address,undefined -fno-omit-frame-pointer",

        "CMAKE_EXE_LINKER_FLAGS_DEBUG":    "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS_DEBUG": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "release",
      "displayName": "Release Config",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_DEBUG": "-Wall -Wextra -fdiagnostics-color=always",
        "CMAKE_C_FLAGS_DEBUG":   "-Wall -Wextra -fdiagnostics-color=always"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ]
}
