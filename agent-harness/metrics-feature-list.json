{
  "version": "3.0",
  "lastUpdated": "2026-02-19",
  "description": "Metrics Page Development Plan - Based on Backend Prometheus/Grafana Integration Solution",
  "testConfig": {
    "baseUrl": "http://localhost:5173",
    "testTimeout": 30000,
    "screenshotDir": "logs/screenshots"
  },
  "backendIntegration": {
    "description": "Backend has implemented Prometheus metrics export, frontend needs to integrate",
    "prometheusEndpoint": "http://localhost:30091",
    "grafanaEndpoint": "http://localhost:30092",
    "agentMetricsEndpoint": "http://<agent-ip>:8080/metrics",
    "prometheusMetrics": [
      {
        "name": "kuro_pod_traffic_bytes_total",
        "type": "counter",
        "labels": ["pod", "direction", "type"],
        "description": "Total transmitted bytes"
      },
      {
        "name": "kuro_pod_traffic_packets_total",
        "type": "counter",
        "labels": ["pod", "direction", "type"],
        "description": "Total transmitted packets"
      },
      {
        "name": "kuro_pod_drop_bytes_total",
        "type": "counter",
        "labels": ["pod", "direction", "type"],
        "description": "Total dropped bytes"
      },
      {
        "name": "kuro_pod_drop_packets_total",
        "type": "counter",
        "labels": ["pod", "direction", "type"],
        "description": "Total dropped packets"
      },
      {
        "name": "kuro_pod_latency_seconds",
        "type": "histogram",
        "labels": ["pod"],
        "description": "Latency histogram"
      }
    ]
  },
  "features": [
    {
      "id": "METRICS-001",
      "category": "integration",
      "priority": "high",
      "name": "Grafana iframe Integration",
      "description": "Embed Grafana dashboard iframe in frontend page, directly display Grafana panels configured in backend",
      "codeTests": [
        "Verify GrafanaEmbed component rendering",
        "Verify iframe URL configuration"
      ],
      "browserTests": [
        "Navigate to /metrics page",
        "Verify Grafana iframe loads",
        "Verify fullscreen toggle functionality",
        "Screenshot record"
      ],
      "passes": true,
      "lastTested": "2026-02-19",
      "notes": "Use Grafana's iframe embed mode, URL: http://localhost:30092/d/kuro-dashboard",
      "retryCount": 0,
      "backendRequired": true,
      "backendEndpoint": "Grafana Service (NodePort 30092)",
      "mockRequired": false,
      "implementation": {
        "component": "GrafanaEmbed.tsx",
        "props": {
          "dashboardUid": "kuro-dashboard",
          "refresh": "5s",
          "theme": "dark"
        }
      }
    },
    {
      "id": "METRICS-002",
      "category": "component",
      "priority": "high",
      "name": "Prometheus Query Service",
      "description": "Create Prometheus HTTP API client for directly querying Prometheus data",
      "codeTests": [
        "Verify prometheusClient configuration",
        "Verify query functions"
      ],
      "browserTests": [
        "Verify API calls are correct"
      ],
      "passes": true,
      "lastTested": "2026-02-19",
      "notes": "Prometheus HTTP API: http://localhost:30091/api/v1/query",
      "retryCount": 0,
      "backendRequired": true,
      "backendEndpoint": "Prometheus Service (NodePort 30091)",
      "mockRequired": true,
      "implementation": {
        "file": "frontend/src/api/prometheus.ts",
        "functions": [
          "instantQuery(query: string)",
          "rangeQuery(query: string, start: number, end: number, step: string)",
          "getMetricNames()",
          "getLabelValues(label: string)"
        ],
        "exampleQueries": [
          "sum(rate(kuro_pod_traffic_bytes_total[5m])) by (pod)",
          "histogram_quantile(0.95, rate(kuro_pod_latency_seconds_bucket[5m]))",
          "sum(rate(kuro_pod_drop_packets_total[5m])) by (pod, direction)"
        ]
      }
    },
    {
      "id": "METRICS-003",
      "category": "component",
      "priority": "high",
      "name": "Bandwidth Traffic Chart",
      "description": "Display bandwidth usage trends for all Pods, query kuro_pod_traffic_bytes_total from Prometheus",
      "codeTests": [
        "Verify BandwidthChart component",
        "Verify data formatting"
      ],
      "browserTests": [
        "Verify chart rendering",
        "Verify time range selection",
        "Screenshot record"
      ],
      "passes": true,
      "lastTested": "2026-02-19",
      "notes": "Use ECharts for rendering, query: rate(kuro_pod_traffic_bytes_total[5m])",
      "retryCount": 0,
      "backendRequired": true,
      "backendEndpoint": "Prometheus API",
      "mockRequired": true,
      "implementation": {
        "component": "BandwidthChart.tsx",
        "prometheusQuery": "sum(rate(kuro_pod_traffic_bytes_total{type=\"sim\"}[5m])) by (pod, direction)",
        "chartType": "line"
      }
    },
    {
      "id": "METRICS-004",
      "category": "component",
      "priority": "high",
      "name": "Latency Distribution Chart",
      "description": "Display Pod latency distribution histogram, query kuro_pod_latency_seconds from Prometheus",
      "codeTests": [
        "Verify LatencyChart component",
        "Verify percentile calculation"
      ],
      "browserTests": [
        "Verify histogram rendering",
        "Verify P95/P99 display",
        "Screenshot record"
      ],
      "passes": true,
      "lastTested": "2026-02-19",
      "notes": "Query: histogram_quantile(0.95, rate(kuro_pod_latency_seconds_bucket[5m]))",
      "retryCount": 0,
      "backendRequired": true,
      "backendEndpoint": "Prometheus API",
      "mockRequired": true,
      "implementation": {
        "component": "LatencyChart.tsx",
        "prometheusQueries": {
          "p50": "histogram_quantile(0.50, rate(kuro_pod_latency_seconds_bucket[5m]))",
          "p95": "histogram_quantile(0.95, rate(kuro_pod_latency_seconds_bucket[5m]))",
          "p99": "histogram_quantile(0.99, rate(kuro_pod_latency_seconds_bucket[5m]))"
        },
        "chartType": "heatmap"
      }
    },
    {
      "id": "METRICS-005",
      "category": "component",
      "priority": "high",
      "name": "Packet Loss Monitoring Panel",
      "description": "Display packet loss rate for each Pod, query kuro_pod_drop_packets_total from Prometheus",
      "codeTests": [
        "Verify PacketLossPanel component",
        "Verify packet loss rate calculation"
      ],
      "browserTests": [
        "Verify panel rendering",
        "Verify alert colors",
        "Screenshot record"
      ],
      "passes": true,
      "lastTested": "2026-02-19",
      "notes": "Packet loss rate = drop_packets / traffic_packets * 100",
      "retryCount": 0,
      "backendRequired": true,
      "backendEndpoint": "Prometheus API",
      "mockRequired": true,
      "implementation": {
        "component": "PacketLossPanel.tsx",
        "prometheusQuery": "sum(rate(kuro_pod_drop_packets_total[5m])) by (pod) / sum(rate(kuro_pod_traffic_packets_total[5m])) by (pod) * 100",
        "alertThresholds": {
          "warning": 0.1,
          "critical": 1.0
        }
      }
    },
    {
      "id": "METRICS-006",
      "category": "component",
