{
  "version": "3.0",
  "lastUpdated": "2026-02-19",
  "description": "Metrics 页面开发计划 - 基于后端 Prometheus/Grafana 集成方案",
  "testConfig": {
    "baseUrl": "http://localhost:5173",
    "testTimeout": 30000,
    "screenshotDir": "logs/screenshots"
  },
  "backendIntegration": {
    "description": "后端已实现 Prometheus metrics 导出，前端需要对接",
    "prometheusEndpoint": "http://localhost:30091",
    "grafanaEndpoint": "http://localhost:30092",
    "agentMetricsEndpoint": "http://<agent-ip>:8080/metrics",
    "prometheusMetrics": [
      {
        "name": "kuro_pod_traffic_bytes_total",
        "type": "counter",
        "labels": ["pod", "direction", "type"],
        "description": "总传输字节数"
      },
      {
        "name": "kuro_pod_traffic_packets_total",
        "type": "counter",
        "labels": ["pod", "direction", "type"],
        "description": "总传输包数"
      },
      {
        "name": "kuro_pod_drop_bytes_total",
        "type": "counter",
        "labels": ["pod", "direction", "type"],
        "description": "总丢弃字节数"
      },
      {
        "name": "kuro_pod_drop_packets_total",
        "type": "counter",
        "labels": ["pod", "direction", "type"],
        "description": "总丢弃包数"
      },
      {
        "name": "kuro_pod_latency_seconds",
        "type": "histogram",
        "labels": ["pod"],
        "description": "延迟直方图"
      }
    ]
  },
  "features": [
    {
      "id": "METRICS-001",
      "category": "integration",
      "priority": "high",
      "name": "Grafana iframe 集成",
      "description": "在前端页面中嵌入 Grafana 仪表板 iframe，直接展示后端已配置的 Grafana 面板",
      "codeTests": [
        "验证 GrafanaEmbed 组件渲染",
        "验证 iframe URL 配置"
      ],
      "browserTests": [
        "导航到 /metrics 页面",
        "验证 Grafana iframe 加载",
        "验证全屏切换功能",
        "截图记录"
      ],
      "passes": false,
      "lastTested": null,
      "notes": "使用 Grafana 的 iframe 嵌入模式，URL: http://localhost:30092/d/kuro-dashboard",
      "retryCount": 0,
      "backendRequired": true,
      "backendEndpoint": "Grafana Service (NodePort 30092)",
      "mockRequired": false,
      "implementation": {
        "component": "GrafanaEmbed.tsx",
        "props": {
          "dashboardUid": "kuro-dashboard",
          "refresh": "5s",
          "theme": "dark"
        }
      }
    },
    {
      "id": "METRICS-002",
      "category": "component",
      "priority": "high",
      "name": "Prometheus 查询服务",
      "description": "创建 Prometheus HTTP API 客户端，用于直接查询 Prometheus 数据",
      "codeTests": [
        "验证 prometheusClient 配置",
        "验证查询函数"
      ],
      "browserTests": [
        "验证 API 调用正确"
      ],
      "passes": true,
      "lastTested": "2026-02-19",
      "notes": "Prometheus HTTP API: http://localhost:30091/api/v1/query",
      "retryCount": 0,
      "backendRequired": true,
      "backendEndpoint": "Prometheus Service (NodePort 30091)",
      "mockRequired": true,
      "implementation": {
        "file": "frontend/src/api/prometheus.ts",
        "functions": [
          "instantQuery(query: string)",
          "rangeQuery(query: string, start: number, end: number, step: string)",
          "getMetricNames()",
          "getLabelValues(label: string)"
        ],
        "exampleQueries": [
          "sum(rate(kuro_pod_traffic_bytes_total[5m])) by (pod)",
          "histogram_quantile(0.95, rate(kuro_pod_latency_seconds_bucket[5m]))",
          "sum(rate(kuro_pod_drop_packets_total[5m])) by (pod, direction)"
        ]
      }
    },
    {
      "id": "METRICS-003",
      "category": "component",
      "priority": "high",
      "name": "带宽流量图表",
      "description": "显示所有 Pod 的带宽使用趋势，从 Prometheus 查询 kuro_pod_traffic_bytes_total",
      "codeTests": [
        "验证 BandwidthChart 组件",
        "验证数据格式化"
      ],
      "browserTests": [
        "验证图表渲染",
        "验证时间范围选择",
        "截图记录"
      ],
      "passes": true,
      "lastTested": "2026-02-19",
      "notes": "使用 ECharts 渲染，查询: rate(kuro_pod_traffic_bytes_total[5m])",
      "retryCount": 0,
      "backendRequired": true,
      "backendEndpoint": "Prometheus API",
      "mockRequired": true,
      "implementation": {
        "component": "BandwidthChart.tsx",
        "prometheusQuery": "sum(rate(kuro_pod_traffic_bytes_total{type=\"sim\"}[5m])) by (pod, direction)",
        "chartType": "line"
      }
    },
    {
      "id": "METRICS-004",
      "category": "component",
      "priority": "high",
      "name": "延迟分布图表",
      "description": "显示 Pod 延迟分布直方图，从 Prometheus 查询 kuro_pod_latency_seconds",
      "codeTests": [
        "验证 LatencyChart 组件",
        "验证百分位计算"
      ],
      "browserTests": [
        "验证直方图渲染",
        "验证 P95/P99 显示",
        "截图记录"
      ],
      "passes": true,
      "lastTested": "2026-02-19",
      "notes": "查询: histogram_quantile(0.95, rate(kuro_pod_latency_seconds_bucket[5m]))",
      "retryCount": 0,
      "backendRequired": true,
      "backendEndpoint": "Prometheus API",
      "mockRequired": true,
      "implementation": {
        "component": "LatencyChart.tsx",
        "prometheusQueries": {
          "p50": "histogram_quantile(0.50, rate(kuro_pod_latency_seconds_bucket[5m]))",
          "p95": "histogram_quantile(0.95, rate(kuro_pod_latency_seconds_bucket[5m]))",
          "p99": "histogram_quantile(0.99, rate(kuro_pod_latency_seconds_bucket[5m]))"
        },
        "chartType": "heatmap"
      }
    },
    {
      "id": "METRICS-005",
      "category": "component",
      "priority": "high",
      "name": "丢包率监控面板",
      "description": "显示各 Pod 的丢包率，从 Prometheus 查询 kuro_pod_drop_packets_total",
      "codeTests": [
        "验证 PacketLossPanel 组件",
        "验证丢包率计算"
      ],
      "browserTests": [
        "验证面板渲染",
        "验证告警颜色",
        "截图记录"
      ],
      "passes": true,
      "lastTested": "2026-02-19",
      "notes": "丢包率 = drop_packets / traffic_packets * 100",
      "retryCount": 0,
      "backendRequired": true,
      "backendEndpoint": "Prometheus API",
      "mockRequired": true,
      "implementation": {
        "component": "PacketLossPanel.tsx",
        "prometheusQuery": "sum(rate(kuro_pod_drop_packets_total[5m])) by (pod) / sum(rate(kuro_pod_traffic_packets_total[5m])) by (pod) * 100",
        "alertThresholds": {
          "warning": 0.1,
          "critical": 1.0
        }
      }
    },
    {
      "id": "METRICS-006",
      "category": "component",
      "priority": "medium",
      "name": "Pod 选择器",
      "description": "允许用户选择要监控的 Pod，支持多选",
      "codeTests": [
        "验证 PodSelector 组件",
        "验证选择状态管理"
      ],
      "browserTests": [
        "验证下拉列表",
        "验证多选功能",
        "截图记录"
      ],
      "passes": true,
      "lastTested": "2026-02-19",
      "notes": "从 Prometheus 获取 pod 标签值列表",
      "retryCount": 0,
      "backendRequired": true,
      "backendEndpoint": "Prometheus API: /api/v1/label/pod/values",
      "mockRequired": true,
      "implementation": {
        "component": "PodSelector.tsx",
        "dataSource": "prometheus.getLabelValues('pod')"
      }
    },
    {
      "id": "METRICS-007",
      "category": "component",
      "priority": "medium",
      "name": "时间范围选择器",
      "description": "选择查询的时间范围（5m, 15m, 1h, 6h, 24h）",
      "codeTests": [
        "验证 TimeRangeSelector 组件",
        "验证预设选项"
      ],
      "browserTests": [
        "验证按钮组",
        "验证选择后图表更新",
        "截图记录"
      ],
      "passes": true,
      "lastTested": "2026-02-19",
      "notes": "用于 Prometheus range query",
      "retryCount": 0,
      "backendRequired": false,
      "mockRequired": false,
      "implementation": {
        "component": "TimeRangeSelector.tsx",
        "options": ["5m", "15m", "1h", "6h", "24h"]
      }
    },
    {
      "id": "METRICS-008",
      "category": "component",
      "priority": "medium",
      "name": "自动刷新控制",
      "description": "控制仪表板自动刷新间隔",
      "codeTests": [
        "验证 useAutoRefresh hook",
        "验证定时器逻辑"
      ],
      "browserTests": [
        "验证刷新间隔选择",
        "验证暂停/恢复"
      ],
      "passes": true,
      "lastTested": "2026-02-19",
      "notes": "默认 5 秒，支持 5s/10s/30s/1m",
      "retryCount": 0,
      "backendRequired": false,
      "mockRequired": false,
      "implementation": {
        "hook": "useAutoRefresh.ts",
        "intervals": [5000, 10000, 30000, 60000]
      }
    },
    {
      "id": "METRICS-009",
      "category": "page",
      "priority": "high",
      "name": "Metrics 页面布局",
      "description": "整合所有组件的 Metrics 页面主布局",
      "codeTests": [
        "验证 MetricsPage 组件",
        "验证布局结构"
      ],
      "browserTests": [
        "导航到 /metrics",
        "验证所有组件渲染",
        "验证响应式布局",
        "截图记录"
      ],
      "passes": true,
      "lastTested": "2026-02-19",
      "notes": "包含 Grafana iframe + 自定义图表",
      "retryCount": 0,
      "backendRequired": false,
      "mockRequired": true,
      "implementation": {
        "file": "frontend/src/pages/MetricsPage.tsx",
        "layout": {
          "header": ["PodSelector", "TimeRangeSelector", "RefreshControl"],
          "main": ["GrafanaEmbed", "BandwidthChart", "LatencyChart", "PacketLossPanel"]
        }
      }
    },
    {
      "id": "METRICS-010",
      "category": "api",
      "priority": "high",
      "name": "Mock Prometheus 数据",
      "description": "创建 Prometheus API mock 响应数据，用于开发和测试",
      "codeTests": [
        "验证 mock 函数",
        "验证数据格式符合 Prometheus API 规范"
      ],
      "browserTests": [
        "验证组件能消费 mock 数据"
      ],
      "passes": true,
      "lastTested": "2026-02-19",
      "notes": "模拟 Prometheus HTTP API 响应格式",
      "retryCount": 0,
      "backendRequired": false,
      "mockRequired": true,
      "implementation": {
        "file": "frontend/src/api/prometheusMock.ts",
        "functions": [
          "mockInstantQuery(query: string)",
          "mockRangeQuery(query: string, start: number, end: number, step: string)",
          "mockLabelValues(label: string)"
        ],
        "dataFormat": {
          "status": "success",
          "data": {
            "resultType": "vector",
            "result": [
              {
                "metric": { "pod": "drone-0", "direction": "download" },
                "values": [[1708358400, "1234567"]]
              }
            ]
          }
        }
      }
    },
    {
      "id": "METRICS-011",
      "category": "config",
      "priority": "low",
      "name": "Grafana Dashboard 配置",
      "description": "文档说明如何配置 Grafana Dashboard",
      "codeTests": [],
      "browserTests": [],
      "passes": false,
      "lastTested": null,
      "notes": "参考 deploy/quick-monitor.yaml 中的 Grafana 部署配置",
      "retryCount": 0,
      "backendRequired": true,
      "mockRequired": false,
      "implementation": {
        "file": "docs/grafana-setup.md",
        "content": [
          "部署 Grafana: kubectl apply -f deploy/quick-monitor.yaml",
          "访问 Grafana: http://localhost:30092 (admin/admin)",
          "添加 Prometheus 数据源: http://prometheus:9090",
          "导入 Dashboard: 创建 Kuro Dashboard"
        ]
      }
    }
  ],
  "developmentOrder": [
    {
      "phase": 1,
      "name": "基础设施",
      "features": ["METRICS-010", "METRICS-002", "METRICS-007", "METRICS-008"],
      "description": "创建 Mock 数据、Prometheus 客户端、基础组件"
    },
    {
      "phase": 2,
      "name": "核心图表",
      "features": ["METRICS-003", "METRICS-004", "METRICS-005"],
      "description": "实现带宽、延迟、丢包图表"
    },
    {
      "phase": 3,
      "name": "页面集成",
      "features": ["METRICS-006", "METRICS-009"],
      "description": "整合所有组件到 Metrics 页面"
    },
    {
      "phase": 4,
      "name": "Grafana 集成",
      "features": ["METRICS-001", "METRICS-011"],
      "description": "嵌入 Grafana iframe（需要后端支持）"
    }
  ],
  "backendEndpoints": {
    "prometheus": {
      "url": "http://localhost:30091",
      "api": {
        "instantQuery": "/api/v1/query",
        "rangeQuery": "/api/v1/query_range",
        "labelValues": "/api/v1/label/{label}/values",
        "series": "/api/v1/series"
      }
    },
    "grafana": {
      "url": "http://localhost:30092",
      "embed": "/d-solo/{dashboardUid}?orgId=1&refresh=5s&theme=dark&panelId={panelId}",
      "defaultDashboard": "kuro-dashboard"
    },
    "agentMetrics": {
      "url": "http://<pod-ip>:8080/metrics",
      "format": "Prometheus text format"
    }
  }
}
