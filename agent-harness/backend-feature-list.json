{
  "version": "1.0",
  "lastUpdated": "2026-02-19",
  "description": "Kuro Backend Feature Complete List - Generated from code analysis",
  "architecture": {
    "components": [
      {
        "name": "Controller",
        "description": "Central controller, manages K8s CRDs and Agent communication",
        "entrypoint": "cmd/controller/main.go",
        "ports": {
          "grpc": 9090,
          "http": 8080,
          "healthz": 8081
        }
      },
      {
        "name": "Agent",
        "description": "Node agent, manages local Pods and eBPF programs",
        "entrypoint": "cmd/agent/main.go",
        "ports": {
          "metrics": 8080
        }
      }
    ]
  },
  "features": [
    {
      "id": "BACKEND-001",
      "category": "controller",
      "priority": "critical",
      "status": "implemented",
      "name": "K8s Manager Initialization",
      "description": "Initialize K8s controller-runtime Manager when Controller starts",
      "implementation": {
        "file": "internal/controller/controller.go",
        "function": "InitK8sManager",
        "features": [
          "Register NetworkTopology CRD",
          "Register TrafficControl CRD",
          "Configure health checks (healthz/readyz)",
          "Leader Election (currently disabled)"
        ]
      },
      "tests": ["make test", "kubectl get crd"],
      "notes": "Leader Election should be enabled in production"
    },
    {
      "id": "BACKEND-002",
      "category": "controller",
      "priority": "critical",
      "status": "implemented",
      "name": "gRPC Server",
      "description": "Controller provides gRPC service to receive Agent connections",
      "implementation": {
        "file": "internal/controller/controller.go",
        "function": "runGrpcServer",
        "port": 9090,
        "proto": "api/proto/v1/simulation.proto"
      },
      "api": {
        "service": "SimulationAgentService",
        "method": "ControlStream(stream AgentMsg) returns (stream ControllerCmd)"
      },
      "tests": ["test/e2e/e2e_grpc_full_test.go"],
      "notes": "Bidirectional streaming RPC"
    },
    {
      "id": "BACKEND-003",
      "category": "controller",
      "priority": "critical",
      "status": "implemented",
      "name": "HTTP API Server",
      "description": "Controller provides HTTP API for frontend and external calls",
      "implementation": {
        "file": "internal/controller/api/server.go",
        "port": 8080
      },
      "endpoints": [
        {
          "method": "GET",
          "path": "/api/v1/topology",
          "description": "Get topology structure (all simulation nodes)"
        },
        {
          "method": "GET",
          "path": "/api/v1/agents",
          "description": "List all connected Agents"
        },
        {
          "method": "POST",
          "path": "/api/v1/policy/link",
          "description": "Manually apply link policy"
        },
        {
          "method": "POST",
          "path": "/api/v1/policy/pod",
          "description": "Manually apply Pod policy"
        },
        {
          "method": "POST",
          "path": "/api/v1/policy/node",
          "description": "Manually apply node policy"
        }
      ],
      "tests": ["internal/controller/api/server_test.go"],
      "notes": "Current API is limited, frontend needs extension"
    },
    {
      "id": "BACKEND-004",
      "category": "controller",
      "priority": "critical",
      "status": "implemented",
      "name": "Agent Connection Management",
      "description": "Manage Agent registration, heartbeat, and disconnection",
      "implementation": {
        "file": "internal/controller/controller.go",
        "functions": ["RegisterAgent", "UnregisterAgent", "HandleHeartbeat", "HandleAck"]
      },
      "features": [
        "Automatically trigger TrafficControl resync when Agent registers",
        "Process Pod events reported by Agent",
        "Process Agent command acknowledgment (ACK)"
      ],
      "knownIssues": [
        {
          "id": "FIXME-001",
          "description": "Agent reconnection triggers massive K8s API Patch requests, may cause Throttling",
          "impact": "50 TrafficControls × 100 nodes = 5000 patches"
        }
      ],
      "notes": "Reconnection logic needs optimization"
    },
    {
      "id": "BACKEND-005",
      "category": "controller",
      "priority": "critical",
      "status": "implemented",
      "name": "NetworkTopology Reconciler",
      "description": "Watch NetworkTopology CRD changes and create corresponding Deployments",
      "implementation": {
        "file": "internal/controller/k8s/topology_controller.go",
        "watch": "NetworkTopology CRD"
      },
      "features": [
        "Parse NodeGroups configuration",
        "Create Deployment (supports replicas)",
        "Create ConfigMap (UserProgram injection)",
        "Set OwnerReference (auto cleanup)"
      ],
      "tests": ["kubectl apply -f deploy/test-topology.yaml"],
      "notes": "Supports user code injection"
    },
    {
      "id": "BACKEND-006",
      "category": "controller",
      "priority": "critical",
      "status": "implemented",
      "name": "TrafficControl Reconciler",
      "description": "Watch TrafficControl CRD changes and push policies to Agent",
      "implementation": {
        "file": "internal/controller/k8s/traffic_controller.go",
        "watch": "TrafficControl CRD"
      },
      "features": [
        "Parse policy parameters (bandwidth/latency/jitter/packetLoss)",
        "Find Source/Destination Pods",
        "Generate all links via Cartesian product",
        "Push policies to Agent via gRPC",
        "Generation change detection (avoid duplicate processing)"
      ],
      "tests": ["kubectl apply -f deploy/test-traffic.yaml"],
      "notes": "Policies are pushed to Agent on Source node"
    },
    {
      "id": "BACKEND-007",
      "category": "controller",
      "priority": "high",
      "status": "implemented",
      "name": "TrafficControl Status Update",
      "description": "Update TrafficControl status based on Agent ACK",
      "implementation": {
        "file": "internal/controller/controller.go",
        "function": "updateTrafficControlStatus"
      },
      "features": [
        "Use RetryOnConflict for concurrent updates",
        "Update ActiveNodes list",
        "Update Phase and Message",
        "Update ObservedGeneration"
      ],
      "notes": "Namespace currently hardcoded as kuro-experiment"
    },
    {
      "id": "BACKEND-008",
      "category": "agent",
      "priority": "critical",
      "status": "implemented",
      "name": "Agent Main Loop",
      "description": "Agent startup and main event loop",
      "implementation": {
        "file": "internal/agent/agent.go",
        "function": "Run"
      },
      "features": [
        "Start HTTP Metrics service (:8080)",
        "Start gRPC Client to connect to Controller",
        "Initialize BPF default rules (ingress protection, NIC egress)",
        "Start local Pod Watcher",
        "Event forwarding (LocalWatcher → gRPC Client)"
      ],
      "tests": ["test/e2e/e2e_watcher_test.go"],
      "notes": "Supports Containerd runtime"
    },
    {
      "id": "BACKEND-009",
      "category": "agent",
      "priority": "critical",
      "status": "implemented",
      "name": "Local Pod Watcher",
      "description": "Watch Pod lifecycle events on local node",
      "implementation": {
        "file": "internal/agent/watch/local_watcher.go",
        "runtime": "internal/agent/watch/container_runtime.go"
      },
      "features": [
        "Watch container events via Containerd API",
        "Get Pod netns and veth info",
        "Filter Pods with kuro.io/sim-node=true",
        "Report Pod events to Controller"
      ],
      "tests": ["test/e2e/e2e_watcher_test.go"],
      "notes": "Containerd socket can be configured via environment variable"
    },
    {
      "id": "BACKEND-010",
      "category": "agent",
      "priority": "critical",
      "status": "implemented",
      "name": "BPF Manager",
      "description": "eBPF program loading and management",
      "implementation": {
        "file": "internal/agent/bpf/manager.go",
        "bpfSource": "bpf/tc.c",
        "maps": "bpf/include/map.h"
      },
      "features": [
        "Load TC/XDP BPF programs",
        "Pod interface management (AddPod, RemovePod, EnsurePodAttached)",
        "Policy configuration (UpdateRule, SetPolicy)",
        "Ingress Protection (XDP)",
        "NIC Egress Hook"
      ],
      "tests": ["test/bpf/bpf_dual_rate_test.go", "test/bpf/bpf_isolation_test.go"],
      "notes": "Uses cilium/ebpf library"
    },
    {
      "id": "BACKEND-011",
      "category": "agent",
      "priority": "high",
      "status": "implemented",
      "name": "Ingress Protection (XDP)",
      "description": "Physical NIC ingress traffic rate limiting",
      "implementation": {
        "file": "internal/agent/bpf/manager.go",
        "function": "AttachIngressProtection",
        "bpfProgram": "handle_xdp_ingress"
      },
      "features": [
        "XDP driver mode preferred, fallback to Generic mode",
        "Auto-detect NIC speed (default 1Gbps)",
        "System traffic limited to 90% of physical capacity",
        "Token Bucket algorithm"
      ],
      "tests": ["test/bpf/bpf_xdp_test.go"],
      "notes": "Protect system traffic from consuming all bandwidth"
    },
    {
      "id": "BACKEND-012",
      "category": "agent",
      "priority": "high",
      "status": "implemented",
      "name": "Download Control (TC Egress)",
      "description": "Host Veth egress traffic control (Host → Pod)",
      "implementation": {
        "file": "internal/agent/bpf/manager.go",
        "bpfProgram": "handle_edt_download"
      },
      "features": [
        "EDT (Earliest Departure Time) algorithm",
        "Distinguish simulation traffic from system traffic",
        "Port bypass (SSH 22, Kubelet 10250, Metrics 9100)",
        "Topology policy lookup (topology_policy_map)"
      ],
      "tests": ["test/bpf/bpf_dualdirection_test.go"],
      "notes": "Attached at Host Veth Egress"
    },
    {
      "id": "BACKEND-013",
      "category": "agent",
      "priority": "high",
      "status": "implemented",
      "name": "Upload Control (TC Egress)",
      "description": "Pod eth0 egress traffic control (Pod → Host)",
      "implementation": {
        "file": "internal/agent/bpf/manager.go",
        "bpfProgram": "handle_edt_upload"
      },
      "features": [
        "Enter Pod netns for attachment",
        "EDT algorithm",
        "Simulation/system traffic distinction",
        "Symmetric with Download Control"
      ],
      "tests": ["test/bpf/bpf_dualdirection_test.go"],
      "notes": "Requires netns switching"
    },
    {
      "id": "BACKEND-014",
      "category": "agent",
      "priority": "high",
      "status": "implemented",
      "name": "NIC Egress (Global Sys Latency)",
      "description": "Physical NIC egress, add latency for system traffic",
      "implementation": {
        "file": "internal/agent/bpf/manager.go",
        "function": "AttachNICEgress",
        "bpfProgram": "handle_eth0_egress"
      },
      "features": [
        "Add 3ms latency for system traffic (SYS_LATENCY_OFFSET_NS)",
        "Simulation traffic sent first",
        "FQ qdisc coordination"
      ],
      "tests": ["test/bpf/bpf_eth0_test.go"],
      "notes": "Ensure simulation traffic has higher priority than system traffic"
    },
    {
      "id": "BACKEND-015",
      "category": "agent",
      "priority": "high",
      "status": "implemented",
      "name": "Prometheus Metrics Export",
      "description": "Agent exposes Prometheus format metrics",
      "implementation": {
        "file": "internal/agent/opsapi/http_service.go",
        "port": 8080,
        "endpoint": "/metrics"
      },
      "metrics": [
        {
          "name": "kuro_pod_traffic_bytes_total",
          "type": "counter",
          "labels": ["pod", "direction", "type"],
          "source": "MetricsMap (BPF)"
        },
        {
          "name": "kuro_pod_traffic_packets_total",
          "type": "counter",
          "labels": ["pod", "direction", "type"],
          "source": "MetricsMap (BPF)"
        },
        {
          "name": "kuro_pod_drop_packets_total",
          "type": "counter",
          "labels": ["pod", "direction", "type"],
          "source": "MetricsMap (BPF)"
        },
        {
          "name": "kuro_pod_latency_seconds",
          "type": "histogram",
          "labels": ["pod"],
          "source": "LatencyMap (BPF)"
        }
      ],
      "tests": ["curl http://localhost:8080/metrics"],
      "notes": "Per-CPU aggregation"
    },
    {
      "id": "BACKEND-016",
      "category": "bpf",
      "priority": "critical",
      "status": "implemented",
      "name": "EDT Traffic Shaping",
      "description": "Core traffic shaping algorithm implementation",
      "implementation": {
        "file": "bpf/tc.c",
        "function": "throttle_flow"
      },
      "features": [
        "EDT algorithm based on skb->tstamp",
        "Burst Window (2ms)",
        "Horizon detection (queue overflow drop)",
        "Spin Lock protection for state"
      ],
      "tests": ["test/bpf/benchmark_compare_htb_test.go"],
      "notes": "Better performance than HTB"
    },
    {
      "id": "BACKEND-017",
      "category": "bpf",
      "priority": "high",
      "status": "implemented",
      "name": "Traffic Classification",
      "description": "Distinguish simulation traffic from system traffic",
      "implementation": {
        "file": "bpf/tc.c"
      },
      "features": [
        "Port bypass (system service ports)",
        "Topology policy lookup (topology_policy_map)",
        "Match = simulation traffic",
        "No match = system traffic"
      ],
      "tests": ["test/bpf/bpf_isolation_test.go"],
      "notes": "Supports traffic isolation"
    },
    {
      "id": "BACKEND-018",
      "category": "bpf",
      "priority": "high",
      "status": "implemented",
      "name": "Link Policy",
      "description": "Per-link network parameter configuration",
      "implementation": {
        "file": "bpf/include/map.h",
        "map": "topology_policy_map"
      },
      "features": [
        "Bandwidth limit (bandwidth_bps)",
        "Base latency (base_latency_ns)",
        "Jitter (jitter_ns)",
        "Packet loss rate (corruption_rate_ppm)",
        "Queue depth (queue_depth_ns)"
      ],
      "tests": ["test/bpf/bpf_netem_test.go"],
      "notes": "Aligned with netem functionality"
    },
    {
      "id": "BACKEND-019",
      "category": "bpf",
      "priority": "medium",
      "status": "implemented",
      "name": "BPF Maps",
      "description": "All BPF Map definitions",
      "implementation": {
        "file": "bpf/include/map.h"
      },
      "maps": [
        {
          "name": "config_map",
          "type": "ARRAY",
          "key": "u32",
          "value": "struct global_config",
          "description": "Global configuration (EDT horizon)"
        },
        {
          "name": "rate_map",
          "type": "HASH",
          "key": "u32 (ifindex)",
          "value": "struct io_rate",
          "description": "Interface rate limits (Sim/Sys up/down)"
        },
        {
          "name": "topology_policy_map",
          "type": "HASH",
          "key": "struct policy_key {src_ip, dst_ip}",
          "value": "struct link_policy",
          "description": "Link policy"
        },
        {
          "name": "edt_download_state_map",
          "type": "HASH",
          "key": "u32",
          "value": "struct edt_state",
          "description": "Download EDT state"
        },
        {
          "name": "edt_upload_state_map",
          "type": "HASH",
          "key": "u32",
          "value": "struct edt_state",
          "description": "Upload EDT state"
        },
        {
          "name": "metrics_map",
          "type": "PERCPU_ARRAY",
          "key": "u32",
          "value": "struct pod_stats",
          "description": "Traffic statistics"
        },
        {
          "name": "latency_map",
          "type": "PERCPU_ARRAY",
          "key": "u32",
          "value": "struct latency_hist",
          "description": "Latency histogram"
        },
        {
          "name": "ingress_config_map",
          "type": "ARRAY",
          "key": "u32",
          "value": "struct ingress_config",
          "description": "XDP Ingress configuration"
        },
        {
          "name": "ingress_state_map",
          "type": "HASH",
          "key": "u32",
          "value": "struct ingress_state",
          "description": "XDP Ingress state"
        }
      ],
      "notes": "All Maps have corresponding Go structs"
    },
    {
      "id": "BACKEND-020",
      "category": "crd",
      "priority": "critical",
      "status": "implemented",
      "name": "NetworkTopology CRD",
      "description": "Custom resource for defining network topology",
      "implementation": {
        "file": "api/crd/v1alpha1/networktopology_types.go",
        "group": "simulation.kuro.io",
        "version": "v1alpha1"
      },
      "spec": {
        "nodeGroups": [
          {
            "name": "string",
            "replicas": "int32",
            "image": "string",
            "command": "[]string (optional)",
            "labels": "map[string]string (optional)",
            "userProgram": {
              "source": "string (code content)",
              "mountPath": "string",
              "filename": "string"
            }
          }
        ]
      },
      "status": {
        "readyNodes": "int32"
      },
      "examples": ["deploy/test-topology.yaml"],
      "notes": "Supports user code injection"
    },
    {
      "id": "BACKEND-021",
      "category": "crd",
      "priority": "critical",
      "status": "implemented",
      "name": "TrafficControl CRD",
      "description": "Custom resource for defining traffic control policies",
      "implementation": {
        "file": "api/crd/v1alpha1/trafficcontrol_types.go",
        "group": "simulation.kuro.io",
        "version": "v1alpha1"
      },
      "spec": {
        "priority": "int32 (optional)",
        "source": {
          "matchLabels": "map[string]string"
        },
        "destination": {
          "matchLabels": "map[string]string"
        },
        "policy": {
          "bandwidth": "string (e.g., '10Mbps')",
          "latency": "string (e.g., '50ms')",
          "jitter": "string (e.g., '10ms')",
          "packetLoss": "string (e.g., '0.5%')"
        }
      },
      "status": {
        "phase": "string (Pending/Active/PartialFail/Failed)",
        "activeNodes": "[]string",
        "message": "string",
        "observedGeneration": "int64"
      },
      "examples": ["deploy/test-traffic.yaml"],
      "notes": "Policy applied to Source → Destination direction"
    },
    {
      "id": "BACKEND-022",
      "category": "proto",
      "priority": "critical",
      "status": "implemented",
      "name": "gRPC Protocol",
      "description": "Controller-Agent communication protocol",
      "implementation": {
        "file": "api/proto/v1/simulation.proto"
      },
      "messages": {
        "AgentToController": [
          {
            "name": "Heartbeat",
            "fields": ["node_name", "node_ip", "managed_pod_count"]
          },
          {
            "name": "PodLifecycleEvent",
            "fields": ["type (ADDED/MODIFIED/DELETED)", "pod_name", "namespace", "pod_ip", "container_id", "host_ifindex"]
          },
          {
            "name": "CommandAck",
            "fields": ["command_id", "success", "message"]
          }
        ],
        "ControllerToAgent": [
          {
            "name": "ApplyLinkPolicy",
            "fields": ["src_ip", "dst_ip", "policy"]
          },
          {
            "name": "ApplyPodPolicy",
            "fields": ["pod_name", "namespace", "sim_rate", "sys_rate"]
          },
          {
            "name": "ApplyNodePolicy",
            "fields": ["ingress_limit_bps", "ingress_burst_bytes"]
          }
        ]
      },
      "notes": "Bidirectional streaming RPC"
    },
