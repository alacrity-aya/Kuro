    {
      "id": "BACKEND-025",
      "category": "test",
      "priority": "medium",
      "status": "implemented",
      "name": "性能基准测试",
      "description": "BPF 性能对比测试",
      "implementation": {
        "directory": "test/benchmark"
      },
      "tests": [
        {
          "file": "benchmark_compare_htb_test.go",
          "description": "EDT vs HTB 性能对比"
        },
        {
          "file": "benchmark_xdp_test.go",
          "description": "XDP 性能测试"
        }
      ],
      "runCommand": "./scripts/test.sh -benchmark",
